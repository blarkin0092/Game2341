-- RNG and calls to guarantee randomness
math.randomseed(os.time())
math.random()
math.random()
math.random()
math.random()
math.random()

print("Hello! Welcome to my 1-100 Guessing Game! You get 7 tries...")

again = true -- setting variable for allowing retries
guessesDone = 0 -- to be safe


while again == true do -- retry loop
    correctNumber = math.random(1,100)  -- Number to guess
    while guessesDone < 7 do -- main loop for game
        print("Type in a number 1-100 to guess!")
        input = tonumber(io.read("*n"))
            if input == nil then -- failsafe
            print("Sorry, that's not a number... try again?")
            io.read("*n") end
        if input > correctNumber then
        print("Too high!")
        guessesDone = guessesDone + 1
        else if input < correctNumber then
        print("Too low!")
        guessesDone = guessesDone + 1
        else print("Wow, congrats! You got it right! Wanna play again?")
        print("Y/N") end 
        response = io.read("*l")
        if response == "N" then
            again = false end
    if guessesDone == 7 then
        print("You took too many tries... you lose! Wanna try again?")
        print("Y/N")
        response = io.read() end
        if response == "Y" then
            again = true
        else again = false end
    guessesDone = 0 end
    end
end